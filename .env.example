APP_NAME="Clinica Vida Salud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Administrador por defecto (lo configura el seeder: php artisan migrate:fresh --seed)
ADMIN_CORREO=admin@vidasalud.com
ADMIN_CONTRASENA=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ClinicaVidaSaludDB
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Orígenes del frontend React (Vite) que reciben la cookie de sesión.
# En desarrollo se acepta cualquier puerto local (Vite usa 5174, 5175… si 5173 está ocupado).
# En producción indique el dominio exacto, por ejemplo: SANCTUM_STATEFUL_DOMAINS=app.vidasalud.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Datos de la clínica para documentos impresos (CU18) y enlace del frontend en los correos (CU20)
CLINICA_NOMBRE="Clínica Vida Salud"
CLINICA_DIRECCION="Av. Principal s/n, La Paz, Bolivia"
CLINICA_TELEFONO="(2) 2000000"
FRONTEND_URL=http://localhost:5173

# CU22 – Interpretación de reportes por voz con IA (opcional). Sin clave se usa el intérprete por reglas.
# Requiere curl.cainfo y openssl.cafile configurados en php.ini (paquete de certificados cacert.pem).
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5
ANTHROPIC_TIMEOUT=20

# Pasarela de pago Stripe (Dashboard → Desarrolladores → Claves de API). Usar claves de modo prueba (sk_test_/pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONEDA=bob

# Notificaciones push (CU20). Genere las claves una sola vez: php artisan push:claves
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@vidasalud.com
# Solo si PHP no tiene certificados raíz (desarrollo en Windows), p. ej. el ca-bundle.crt de Git
WEBPUSH_CA_BUNDLE=
